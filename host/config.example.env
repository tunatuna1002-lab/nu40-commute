# ─────────────────────────────────────────────────────────────
# 퇴근 알림 보드 설정 (예시) / Leave-for-your-train board settings (example)
#
# 이 파일을 같은 폴더에 ".env" 로 복사한 뒤 값을 채우세요.
# Copy this file to host/.env and fill in the values.
#   맥/리눅스 (mac/linux):  cp host/config.example.env host/.env
#   윈도우 (windows):       copy host\config.example.env host\.env
#
# 프로젝트 루트의 .env 도 함께 읽습니다. 두 파일에 같은 항목이 있으면 host/.env 가 우선합니다.
# The root .env is read too; host/.env wins when both set the same key.
# .env 는 .gitignore 에 들어 있어 깃에 올라가지 않습니다. 키를 남에게 보여주지 마세요.
# ─────────────────────────────────────────────────────────────

# ── 화면 언어 / On-screen language: en | ko ─────────────────────
# 말풍선·안내 문구와 터미널 로그의 언어. (OS 의 LANG 환경변수와는 무관, 이 파일만 봅니다)
LANG=en

# ── 열차/버스 시각 공급원 / Where times come from: times | gtfs | seoul | bus ──
#   times  고정 시각표. 키·인터넷 불필요, 어디서나.      Fixed departure times. No API key, works anywhere.
#   gtfs   GTFS 정적 피드(폴더나 zip)의 정류장 시각표.  Your transit agency's GTFS static feed (folder or zip).
#   seoul  서울시 지하철 API (시간표 + 실시간 지연 보정). Seoul subway API (timetable + realtime delay).
#   bus    경기도 버스도착정보 v2 (공공데이터포털).     Gyeonggi-do bus arrivals (data.go.kr).
TRAIN_SOURCE=times

# ── times ────────────────────────────────────────────────────
# 시각을 직접 적거나 (HH:MM, 쉼표 구분), 간격으로 만들거나, 둘 다.
# List departures (HH:MM, comma separated), or generate them from an interval, or both.
TRAIN_TIMES=18:02,18:12,18:22,18:32,18:42,18:52,19:02,19:22,19:42,20:02
#TRAIN_EVERY=10            # 10분 간격 (TRAIN_FIRST~TRAIN_LAST) / every 10 min between TRAIN_FIRST and TRAIN_LAST
#TRAIN_FIRST=06:00
#TRAIN_LAST=23:30
#TRAIN_DAYS=mon-fri        # 운행 요일 / which days: mon-fri, weekdays, weekends, mon,wed,fri … (비우면 매일 / empty = every day)

# ── gtfs ─────────────────────────────────────────────────────
# GTFS_PATH 는 압축을 푼 폴더나 .zip. stop_id 는 "python3 host/commute.py --find-stop 'name'" 으로 찾습니다.
# GTFS_PATH is the unzipped folder or the .zip itself. Find your stop_id with: python3 host/commute.py --find-stop "name"
#GTFS_PATH=samples/gtfs_sample
#GTFS_STOP_ID=S1
#GTFS_ROUTE_ID=            # 선택: 노선 route_id (쉼표로 여러 개) / optional: route_id(s), comma separated
#GTFS_DIRECTION_ID=0       # 선택: 0 또는 1 (trips.txt direction_id) / optional: platform direction
#GTFS_HEADSIGN=            # 선택: trip_headsign 에 이 글자가 든 운행만 / optional: only trips whose headsign contains this text

# ── seoul ────────────────────────────────────────────────────
# 서울 열린데이터광장(data.seoul.go.kr) 인증키. 실시간 도착정보·시간표 둘 다 이 키로 됩니다.
# 데모 모드(--demo)나 times/gtfs 만 쓸 거면 비워 둬도 됩니다.
SEOUL_SUBWAY_KEY=
# 역·방면 (기본값 = 삼성역 2호선 잠실 방면). 바꾸려면 DATA_SOURCES.md 를 보고 역코드를 찾으세요.
STATION_NAME=삼성
STATION_CODE=0219
UPDN_LINE=외선
LINE_HINT=종합운동장방면
# 실시간 도착정보를 몇 초마다 부를지 (최소 30, 기본 60). 하루 한도가 약 1,000건입니다.
REALTIME_POLL_SECONDS=60
# 공휴일 (휴일 시간표를 쓸 날짜). 쉼표로 구분, YYYY-MM-DD. host/holidays.py 의 내장 목록에 더해집니다.
HOLIDAYS=

# ── bus (경기도 버스도착정보 v2) ────────────────────────────
# 공공데이터포털에서 '경기도_버스도착정보' 활용신청 후 발급받은 일반 인증키.
# 정류소 ID 는 정류소 조회 API 로 찾습니다:
#   https://apis.data.go.kr/6410000/busstationservice/v2/getBusStationListv2?keyword=정류소이름
# (같은 포털의 경기도_버스정류소정보 키. 브라우저에서 keyword 에 정류소 이름을 넣고 호출)
BUS_API_KEY=
BUS_STATION_ID=213000500             # 예: 철산3동우체국앞
BUS_ROUTES=6616,6638                 # 이 정류소에서 탈 노선 (쉼표 구분)

# ── 공통 / Shared by every source ─────────────────────────────
# 보드가 꽂힌 시리얼 포트. 비워 두면 알아서 찾습니다.   Serial port; leave empty to auto-detect.
#   맥: /dev/cu.usbmodem1101    윈도우: COM3
SERIAL_PORT=

# 회사 → 역 도보 시간(분)과 여유(분). 출발선 = 도착 − (도보 + 여유)
# Walk time desk→platform (min) and a safety buffer (min). Leave line = train − (walk + buffer)
WALK_MINUTES=10
BUFFER_MINUTES=1

# 화면이 자동으로 켜지는 시간대. 이 밖에선 화면을 끄고 데이터도 안 읽습니다. 24시간제 HH:MM. 둘 다 비우면 항상 켜 둡니다.
# Hours the screen is on. Outside it the screen sleeps and APIs are not called. HH:MM; leave both empty for always on.
# 퇴근 예: 18:00~20:00 / 아침 버스 예: 06:30~09:30
ON_AT=18:00
OFF_AT=20:00

# 데모 모드 배속 (--demo). 8이면 1초에 가짜 시간이 8초 흐릅니다.  Demo clock speed for --demo.
DEMO_SPEED=8
