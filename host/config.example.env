# ─────────────────────────────────────────────────────────────
# 버스 출발 알림 보드 설정 (예시) / Leave-for-your-bus board settings (example)
#
# 이 파일을 같은 폴더에 ".env" 로 복사한 뒤 값을 채우세요.
# Copy this file to host/.env and fill in the values.
#   맥/리눅스 (mac/linux):  cp host/config.example.env host/.env
#   윈도우 (windows):       copy host\config.example.env host\.env
#
# 프로젝트 루트의 .env 도 함께 읽습니다. 두 파일에 같은 항목이 있으면 host/.env 가 우선합니다.
# The root .env is read too; host/.env wins when both set the same key.
# .env 는 .gitignore 에 들어 있어 깃에 올라가지 않습니다. 키를 남에게 보여주지 마세요.
# ─────────────────────────────────────────────────────────────

# ── 화면 언어 / On-screen language: en | ko ─────────────────────
# 말풍선·안내 문구와 터미널 로그의 언어. (OS 의 LANG 환경변수와는 무관, 이 파일만 봅니다)
LANG=en

# ── 경기도 버스도착정보 v2 (공공데이터포털 data.go.kr) ─────────────
# '경기도_버스도착정보 조회' 활용신청 후 받은 일반 인증키 (인코딩/디코딩 키 아무거나).
# 정류소 ID 는 정류소 조회 API 로 찾습니다 ('경기도_정류소 조회' 활용신청 필요):
#   https://apis.data.go.kr/6410000/busstationservice/v2/getBusStationListv2?serviceKey=키&keyword=정류소이름&format=json
BUS_API_KEY=
BUS_STATION_ID=213000500             # 예: 철산3동우체국앞
BUS_ROUTES=6616,6638                 # 이 정류소에서 탈 노선 (쉼표 구분). 먼저 오는 탈 수 있는 버스를 보여 줍니다
BUS_POLL_SECONDS=60                  # 몇 초마다 도착정보를 부를지 (최소 30). 실패가 이어지면 최대 10분까지 늘립니다
BUS_DAILY_LIMIT=1000                 # 하루 호출 한도. 닿으면 그날은 더 부르지 않습니다 (0 = 제한 없음)

# ── 보드 / Board ───────────────────────────────────────────────
# 보드가 꽂힌 시리얼 포트. 비워 두면 알아서 찾습니다.   Serial port; leave empty to auto-detect.
#   맥: /dev/cu.usbmodem1101    윈도우: COM3
SERIAL_PORT=

# 집(회사) → 정류소 도보 시간(분)과 여유(분). 출발선 = 도착 − (도보 + 여유)
# Walk time to the stop (min) and a safety buffer (min). Leave line = bus − (walk + buffer)
WALK_MINUTES=4
BUFFER_MINUTES=1

# 화면이 자동으로 켜지는 시간대. 이 밖에선 화면을 끄고 API 도 부르지 않습니다. 24시간제 HH:MM. 둘 다 비우면 항상 켜 둡니다.
# Hours the screen is on. Outside it the screen sleeps and the API is not called. HH:MM; leave both empty for always on.
ON_AT=06:30
OFF_AT=09:30

# 데모 모드 배속 (--demo). 8이면 1초에 가짜 시간이 8초 흐릅니다.  Demo clock speed for --demo.
DEMO_SPEED=8
