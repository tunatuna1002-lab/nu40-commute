# ─────────────────────────────────────────────────────────────
# 퇴근 알림 보드 설정 (예시)
#
# 이 파일을 같은 폴더에 ".env" 로 복사한 뒤 값을 채우세요.
#   맥/리눅스:  cp host/config.example.env host/.env
#   윈도우:     copy host\config.example.env host\.env
#
# 프로젝트 루트의 .env (SEOUL_SUBWAY_KEY 만 있는 파일)도 함께 읽습니다.
# 두 파일에 같은 항목이 있으면 host/.env 가 우선합니다.
# .env 는 .gitignore 에 들어 있어 깃에 올라가지 않습니다. 키를 남에게 보여주지 마세요.
# ─────────────────────────────────────────────────────────────

# 서울 열린데이터광장(data.seoul.go.kr) 인증키. 실시간 도착정보·시간표 둘 다 이 키로 됩니다.
# 데모 모드(--demo)만 쓸 거면 비워 둬도 됩니다.
SEOUL_SUBWAY_KEY=

# 보드가 꽂힌 시리얼 포트. 비워 두면 알아서 찾습니다.
#   맥: /dev/cu.usbmodem1101    윈도우: COM3
SERIAL_PORT=

# 역·방면 (기본값 = 삼성역 2호선 잠실 방면). 바꾸려면 DATA_SOURCES.md 를 보고 역코드를 찾으세요.
STATION_NAME=삼성
STATION_CODE=0219
UPDN_LINE=외선
LINE_HINT=종합운동장방면

# 회사 → 역 도보 시간(분)과 여유(분). 출발선 = 도착 − (도보 + 여유)
WALK_MINUTES=10
BUFFER_MINUTES=1

# 화면이 자동으로 켜지는 시간대 (퇴근 시간). 이 밖에선 화면을 끄고 API 도 부르지 않습니다.
# 24시간제 HH:MM. 둘 다 비우면 항상 켜 둡니다.
ON_AT=18:00
OFF_AT=20:00

# 실시간 도착정보를 몇 초마다 부를지 (최소 30, 기본 60). 하루 한도가 약 1,000건입니다.
REALTIME_POLL_SECONDS=60

# 공휴일 (휴일 시간표를 쓸 날짜). 쉼표로 구분, YYYY-MM-DD.
# host/holidays.py 의 내장 목록에 더해집니다.
HOLIDAYS=

# 데모 모드 배속 (--demo). 8이면 1초에 가짜 시간이 8초 흐릅니다.
DEMO_SPEED=8
